{
  "name": "wuwa-modkit",
  "version": "0.1.0",
  "description": "CDP-based mod loader for Wuwa Tappo (Tauri 2 / WebView2)",
  "private": true,
  "type": "module",
  "bin": {
    "wuwa-modkit": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js --help",
    "lab": "node src/cli.js lab",
    "watch": "node src/cli.js watch",
    "run": "node src/cli.js run",
    "test": "node --test tests/mods.test.js tests/auto-click.test.js",
    "test:app": "node --test tests/modkit-runtime.test.js tests/mod-dialog.test.js && node tests/panel-tab.test.js"
  },
  "engines": {
    "node": ">=22"
  }
}
